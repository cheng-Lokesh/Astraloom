NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase staging
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Keep blank for normal staging validation. Only set on the server when
# explicitly validating server-only writer boundaries.
SUPABASE_SERVICE_ROLE_KEY=

# Backend writer gates. Keep false until RLS, safety, cost, and webhook checks pass.
ENABLE_SYSTEM_WRITERS=false
ENABLE_AI_GENERATION=false
ENABLE_STRIPE_WRITES=false

# AI is invite-only even when ENABLE_AI_GENERATION=true. Keep both blank unless
# you are running a controlled staging beta with named testers.
ALLOWED_AI_TESTER_EMAILS=
ALLOWED_AI_TESTER_USER_IDS=

# Stripe is intentionally disabled for Supabase staging validation.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# DeepSeek/OpenAI-compatible provider is intentionally disabled for Supabase
# staging validation. Do not set API keys unless ENABLE_AI_GENERATION=true has
# been explicitly approved in a later phase.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_FAST=deepseek-v4-flash
DEEPSEEK_MODEL_DEEP=deepseek-v4-pro

# Optional local admin/test token. Leave blank unless a specific admin endpoint
# test requires it.
MIROFISH_ADMIN_TOKEN=
