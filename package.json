{
  "name": "astraloom-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "type-check": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude src/lib/golden-cases/**/*.test.ts",
    "test:golden": "vitest run src/lib/golden-cases/full-product-cases.test.ts --reporter=verbose",
    "test:coverage": "vitest run --coverage",
    "test:hero-render-budget": "node scripts/check-hero-render-budget.mjs",
    "test:interactive-hero": "node scripts/check-interactive-observatory-hero.mjs",
    "check": "npm test && npm run lint && npm run type-check && npm run build",
    "check:ci": "npm run test:coverage && npm run lint && npm run type-check && npm run build"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@xyflow/react": "^12.10.2",
    "gsap": "^3.15.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.184.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
