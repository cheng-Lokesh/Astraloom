{
  "name": "astraloom-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "type-check": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude src/lib/golden-cases/**/*.test.ts",
    "test:golden": "vitest run src/lib/golden-cases/full-product-cases.test.ts --reporter=verbose",
    "test:v2:evidence": "vitest run src/lib/v2/reality-boundary",
    "test:v2:world": "vitest run src/lib/v2/agent-world",
    "test:v2:trajectory": "vitest run src/lib/v2/trajectory/boundary.test.ts src/lib/v2/trajectory/seeded-rng.test.ts src/lib/v2/trajectory/trajectory-runner.test.ts src/lib/v2/trajectory/validation.test.ts",
    "test:v2:analysis": "vitest run src/lib/v2/trajectory-analysis --coverage --coverage.include=src/lib/v2/trajectory-analysis/{batch-runner,child-run-spec,clustering,feature-extraction,feature-integrity,ids,immutable,intervention-comparison,local-adapter,pre-run-transition,sensitivity,simulation-frequency,trajectory-result-validation,types,validation}.ts --coverage.reportsDirectory=coverage/v2-trajectory-analysis --coverage.thresholds.statements=90 --coverage.thresholds.branches=80 --coverage.thresholds.functions=95 --coverage.thresholds.lines=90",
    "test:v2:claims-reports": "vitest run src/lib/v2/claims-reports --coverage --coverage.include=src/lib/v2/claims-reports/**/*.ts --coverage.exclude=src/lib/v2/claims-reports/**/*.test.ts --coverage.reportsDirectory=coverage/v2-claims-reports --coverage.thresholds.statements=90 --coverage.thresholds.branches=80 --coverage.thresholds.functions=95 --coverage.thresholds.lines=90",
    "test:v2:outcome-calibration": "vitest run src/lib/v2/outcome-calibration --coverage --coverage.include=src/lib/v2/outcome-calibration/{backtesting,calibration,ids,in-memory-repository,outcome-capture,repository,types}.ts --coverage.reportsDirectory=coverage/v2-outcome-calibration --coverage.thresholds.statements=90 --coverage.thresholds.branches=85 --coverage.thresholds.functions=95 --coverage.thresholds.lines=90",
    "test:coverage": "vitest run --coverage",
    "test:hero-render-budget": "node scripts/check-hero-render-budget.mjs",
    "test:interactive-hero": "node scripts/check-interactive-observatory-hero.mjs",
    "check": "npm test && npm run lint && npm run type-check && npm run build",
    "check:ci": "npm run test:coverage && npm run lint && npm run type-check && npm run build"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@xyflow/react": "^12.10.2",
    "gsap": "^3.15.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.184.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
